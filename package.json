{
  "name": "linkex-jd2",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "Linkexの共有ファイルを自分のストレージ経由でJDownloader 2に渡すEdge拡張機能",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoyomaru/linkex-jd2.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts && vite build -c vite.frame.config.ts",
    "watch": "node scripts/watch.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test tests/"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
